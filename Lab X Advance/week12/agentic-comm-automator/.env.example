# Copy this file to .env and fill in your own values:
#   copy .env.example .env
# NEVER commit your real .env file!

# Sender Gmail account and its 16-character App Password (NOT your normal password)
# Google Account -> Security -> 2-Step Verification (ON) -> App passwords
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_gmail_app_password

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com

# Recipient for test emails (To) -- the sender is also CC-ed
TEST_RECIPIENT_EMAIL=another_email@example.com

# Recipient for test SMS via email gateway (phone number + carrier key)
# carriers: att, verizon, tmobile, sprint, boost, cricket, us_cellular
TEST_SMS_PHONE_NUMBER=1234567890
TEST_SMS_CARRIER=att

# Your full name and student ID (shown in every email body)
STUDENT_INFO=ชื่อ-นามสกุล รหัสนักศึกษา 663380568-9
